{
  "name": "@tribute/extension",
  "displayName": "Tribute - Bitcoin Tipping",
  "version": "0.1.2",
  "description": "Send Bitcoin tips to creators on Twitter, YouTube, GitHub, and Twitch",
  "author": "trinnex",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@stacks/connect": "^8.2.4",
    "@stacks/network": "^7.0.0",
    "@stacks/transactions": "^7.0.0",
    "@tribute/sdk": "workspace:*",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*.twitter.com/*",
      "https://*.x.com/*",
      "https://*.youtube.com/*",
      "https://*.github.com/*",
      "https://*.twitch.tv/*",
      "https://*.hiro.so/*",
      "https://*.linkedin.com/*"
    ],
    "permissions": [
      "storage",
      "activeTab"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/*"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  }
}
